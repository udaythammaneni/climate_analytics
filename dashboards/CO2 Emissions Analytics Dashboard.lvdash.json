{
  "datasets": [
    {
      "name": "6d9ce6be",
      "displayName": "Global_CO2_Trend",
      "queryLines": [
        "USE CATALOG `unityws`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "    year,\n",
        "    total_global_co2\n",
        "FROM climate_analytics.gold.global_trends\n",
        "ORDER BY year;"
      ]
    },
    {
      "name": "16144186",
      "displayName": "Top Ten Countries by Carbon Emissions Ranking",
      "queryLines": [
        "USE CATALOG `unityws`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "    country,\n",
        "    total_co2\n",
        "FROM climate_analytics.gold.top_polluters\n",
        "ORDER BY total_co2 DESC\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "907625a9",
      "displayName": "Global Trends in Country Carbon Emissions and Growth",
      "queryLines": [
        "USE CATALOG `unityws`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "    country,\n",
        "    year,\n",
        "    co2,\n",
        "    yoy_growth\n",
        "FROM climate_analytics.gold.country_analytics\n",
        "WHERE yoy_growth IS NOT NULL;"
      ]
    },
    {
      "name": "ad19285b",
      "displayName": "Global Emissions Overview as of Recent Trends",
      "queryLines": [
        "SELECT\r\n",
        "    SUM(total_global_co2) AS total_emissions\r\n",
        "FROM climate_analytics.gold.global_trends;"
      ]
    },
    {
      "name": "2d351aa1",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `unityws`;\n",
